# BCCL Enterprise AI Knowledge Retrieval System Configuration

# Environment & Server
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
SECRET_KEY=bccl-enterprise-rag-secret-key-change-in-production-2026

# Database
DATABASE_URL=sqlite:///./data/bccl_rag.db
# For production PostgreSQL + pgvector:
# DATABASE_URL=postgresql://bccl_admin:secure_password@localhost:5432/bccl_rag

# AI & RAG Provider Configuration
# Options for LLM_PROVIDER: auto, gemini, openai, ollama, mock
LLM_PROVIDER=auto

# Options for EMBEDDING_PROVIDER: auto, local, gemini, openai
EMBEDDING_PROVIDER=auto

# OCR Engine
OCR_PROVIDER=tesseract
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# API Keys (Optional: if empty, system runs on zero-API offline mode)
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Ingestion & Chunking Hyperparameters
CHUNK_SIZE=500
CHUNK_OVERLAP=60
MIN_CHUNK_LENGTH=40

# Retrieval & Fusion Hyperparameters
DENSE_SEARCH_WEIGHT=0.65
SPARSE_SEARCH_WEIGHT=0.35
RETRIEVAL_TOP_K=5
RERANKER_TOP_N=10
ENABLE_RERANKER=True
ABSTENTION_THRESHOLD=0.25

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
